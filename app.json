{
  "expo": {
    "name": "Attendance Tracker",
    "slug": "attendance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "attendance",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendancetracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#12131C"
      },
      "package": "com.attendance.tracker",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C111C",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0C111C"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Attendance Tracker to use biometric authentication for app unlock."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Attendance Tracker to access your location to show real-time navigation on campus.",
          "locationAlwaysPermission": "Allow Attendance Tracker to access your location to show real-time navigation on campus.",
          "locationWhenInUsePermission": "Allow Attendance Tracker to access your location to show real-time navigation on campus."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "85a92c4a-5411-40b7-be04-f5a3f561b854"
      }
    },
    "owner": "jathit2645",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/85a92c4a-5411-40b7-be04-f5a3f561b854",
      "fallbackToCacheTimeout": 3000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
